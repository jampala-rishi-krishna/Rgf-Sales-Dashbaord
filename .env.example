# --- Auth ---
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# JSON array of users on ONE line. In a local .env, escape every $ in the bcrypt hash as \$
# (Vite expands $... even inside quotes). In Vercel, paste the raw JSON with no escaping. Roles: viewer | agent | admin. Full guide: docs/ENV_SETUP.md
# Generate a bcrypt hash with:
#   node -e "console.log(require('bcryptjs').hashSync('pw',10))"
DASHBOARD_USERS=[{"email":"","name":"","role":"admin","passwordHash":""}]

# --- Google sign-in (staff SSO) ---
# Button only shows when FEATURE_GOOGLE_SSO=true AND the client ID + secret are set.
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
FEATURE_GOOGLE_SSO=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI if the request origin differs behind a proxy.
GOOGLE_REDIRECT_URI=
# Only verified @rareglobalfood.com accounts are accepted. Role = their DASHBOARD_USERS
# role if listed, else this map. "*" is the default for any other company account;
# leave it out to refuse unlisted staff.
# DASHBOARD_ROLES={"jane@rareglobalfood.com":"agent","*":"viewer"}
DASHBOARD_ROLES=

# Shown as the "Contact your administrator" / Help address on the login page (build-time).
VITE_SUPPORT_EMAIL=

# --- Actions ---
# Anything other than "false" (including missing) = dry run: no n8n/Gmail/Vapi send is made.
ACTIONS_DRY_RUN=true
# Enable dashboard email sending independently of campaign/call dry runs.
GMAIL_SEND_ENABLED=false
N8N_BASE=https://rareglobalfood.app.n8n.cloud/webhook
# Legacy base used by existing read routes (fallback for N8N_BASE)
N8N_WEBHOOK_BASE_URL=https://rareglobalfood.app.n8n.cloud/webhook
N8N_WEBHOOK_AUTH=

# --- Feature flags (n8n endpoints not built yet) ---
FEATURE_MANUAL_REPLY=false
FEATURE_SINGLE_CALL=false
FEATURE_CAMPAIGN_RUNS=false
FEATURE_AGENT_EVENTS=false
FEATURE_CRM=false
# Pre-Lead -> Lead conversion (buttons render disabled "Backend not connected yet" until true).
# Needs the n8n POST /dashboard-convert-lead webhook published.
FEATURE_LEAD_CONVERSION=false
# /leads tab. Needs the n8n GET /dashboard-leads webhook published.
FEATURE_LEADS_TAB=false
# Optional owner list for the Convert dialog: [{"id":"<zoho user id>","name":"...","email":"...","default":true}]
# Without it, owners are taken from the Leads feed. "default" marks the Sales Director.
ZOHO_LEAD_OWNERS=
# Set to true to proxy /dashboard-agent-health even when FEATURE_AGENT_EVENTS=false
AGENT_HEALTH_ENABLED=

# --- Zoho CRM fallback (self-client) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com
