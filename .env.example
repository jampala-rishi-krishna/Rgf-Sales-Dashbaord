# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Twilio (server-only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Vapi (server-only)
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=

# Gmail OAuth2 (server-only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# n8n webhooks (server-only)
N8N_WEBHOOK_BASE_URL=https://rareglobalfood.app.n8n.cloud/webhook

# Google Sheets IDs (client-side, must be VITE_-prefixed)
VITE_EMAIL_SHEET_ID=
VITE_SMS_SHEET_ID=

# Dashboard login gate (client-side, must be VITE_-prefixed — not real auth security)
VITE_LOGIN_EMAIL=
VITE_LOGIN_PASSWORD=
